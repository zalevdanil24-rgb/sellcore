# Скопируйте этот файл в .env и заполните. Файл .env никогда не попадает в GitHub.

# Адрес базы PostgreSQL (выдаст Timeweb Cloud при создании базы)
DATABASE_URL="postgresql://sellcore:password@localhost:5432/sellcore"

# Секрет для входа: любая случайная строка 32+ символов.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=""

# Ключ шифрования токенов WB: 32 байта в base64.
# Сгенерировать: openssl rand -base64 32
# ВАЖНО: храните копию в надёжном месте. Потеря ключа = все токены придётся вводить заново.
TOKEN_ENCRYPTION_KEY=""

# Первый владелец (используется только командой npm run db:seed)
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
